pipeline {
    agent {
        kubernetes {
            yaml """
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: tools
    image: jenkins-agent-tools:local
    imagePullPolicy: Never
    command: [sleep]
    args: [infinity]
    resources:
      requests:
        memory: "1Gi"
        cpu: "500m"
      limits:
        memory: "3Gi"
        cpu: "2000m"
"""
            defaultContainer 'tools'
        }
    }

    environment {
        REPO_A_URL     = 'https://github.com/miindDotVacati0n/grpc.git'
        DOXYGEN_CFG    = 'Doxyfile'
        OUTPUT_ARCHIVE = 'doc.tar.gz'
    }

    stages {

        stage('Checkout RepoA (Shallow)') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/master']],  // ถ้าใช้ main เปลี่ยนเป็น */main
                    userRemoteConfigs: [[url: "${REPO_A_URL}"]],
                    extensions: [
                        [$class: 'CloneOption', depth: 1, shallow: true, noTags: true]
                    ]
                ])
            }
        }

        stage('Verify Repo Structure') {
            steps {
                sh '''
                    echo "===== ROOT FILES ====="
                    ls -la

                    echo "===== CHECK src folder ====="
                    if [ -d "src" ]; then
                        echo "src/ exists ✅"
                    else
                        echo "⚠️ src/ not found, fallback to current directory"
                    fi
                '''
            }
        }

        stage('Generate Doxygen config') {
            steps {
                sh 'doxygen -g ${DOXYGEN_CFG}'
            }
        }

        stage('Adjust Doxygen config') {
            steps {
                sh '''
                    if [ -d "src" ]; then
                        sed -i 's|^INPUT *=.*|INPUT = src|' ${DOXYGEN_CFG}
                    else
                        sed -i 's|^INPUT *=.*|INPUT = .|' ${DOXYGEN_CFG}
                    fi

                    sed -i 's|^GENERATE_LATEX *=.*|GENERATE_LATEX = NO|' ${DOXYGEN_CFG}
                    sed -i 's|^GENERATE_RTF *=.*|GENERATE_RTF   = NO|'   ${DOXYGEN_CFG}
                    sed -i 's|^GENERATE_MAN *=.*|GENERATE_MAN   = NO|'   ${DOXYGEN_CFG}
                    sed -i 's|^GENERATE_XML *=.*|GENERATE_XML   = NO|'   ${DOXYGEN_CFG}
                    sed -i 's|^GENERATE_HTML *=.*|GENERATE_HTML  = YES|' ${DOXYGEN_CFG}

                    echo "===== CONFIG CHECK ====="
                    grep -E "^(INPUT|GENERATE_)" ${DOXYGEN_CFG}
                '''
            }
        }

        stage('Run Doxygen') {
            steps {
                sh 'doxygen ${DOXYGEN_CFG}'
            }
        }

        stage('Verify Output') {
            steps {
                sh '''
                    echo "===== OUTPUT CHECK ====="
                    ls -la

                    if [ ! -d "html" ]; then
                        echo "❌ html/ not generated"
                        exit 1
                    fi
                '''
            }
        }

        stage('Pack output') {
            steps {
                sh 'tar -czf ${OUTPUT_ARCHIVE} html/'
            }
        }

        stage('Archive artifact') {
            steps {
                archiveArtifacts artifacts: "${OUTPUT_ARCHIVE}", fingerprint: true
            }
        }
    }

    post {
        success {
            echo 'PipelineB SUCCESS ✅'
        }
        failure {
            echo 'PipelineB FAILED ❌'
        }
        cleanup {
            cleanWs()
        }
    }
}