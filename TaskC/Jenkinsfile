pipeline {
    agent {
        kubernetes {
            yaml """
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: tools
    image: jenkins-agent-tools:local
    imagePullPolicy: Never
    command: [sleep]
    args: [infinity]
    resources:
      requests:
        memory: "1Gi"
        cpu: "500m"
      limits:
        memory: "3Gi"
        cpu: "2000m"
"""
            defaultContainer 'tools'
        }
    }

    environment {
        REPO_A_URL     = 'https://github.com/miindDotVacati0n/grpc.git'
        REPO_C_URL     = 'https://github.com/miindDotVacati0n/doxygen.git'
        DOXYGEN_CFG    = 'Doxyfile'
        WARNINGS_LOG   = 'doxygen_warnings.log'
        OUTPUT_ARCHIVE = 'doc.tar.gz'
        PARSED_CSV     = 'doxygen_warnings_parsed.csv'
    }

    stages {

        stage('Checkout RepoA (Shallow)') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/master']], // grpc ใช้ master
                    userRemoteConfigs: [[url: "${REPO_A_URL}"]],
                    extensions: [
                        [$class: 'CloneOption', depth: 1, shallow: true, noTags: true]
                    ]
                ])
            }
        }

        stage('Generate Doxygen config') {
            steps {
                sh 'doxygen -g ${DOXYGEN_CFG}'
            }
        }

        stage('Adjust Doxygen config') {
            steps {
                sh '''
                    if [ -d "src" ]; then
                        sed -i 's|^INPUT *=.*|INPUT = src|' ${DOXYGEN_CFG}
                    else
                        sed -i 's|^INPUT *=.*|INPUT = .|' ${DOXYGEN_CFG}
                    fi

                    sed -i 's|^GENERATE_LATEX *=.*|GENERATE_LATEX = NO|' ${DOXYGEN_CFG}
                    sed -i 's|^GENERATE_RTF *=.*|GENERATE_RTF   = NO|'   ${DOXYGEN_CFG}
                    sed -i 's|^GENERATE_MAN *=.*|GENERATE_MAN   = NO|'   ${DOXYGEN_CFG}
                    sed -i 's|^GENERATE_XML *=.*|GENERATE_XML   = NO|'   ${DOXYGEN_CFG}
                    sed -i 's|^GENERATE_HTML *=.*|GENERATE_HTML  = YES|' ${DOXYGEN_CFG}

                    sed -i 's|^WARNINGS *=.*|WARNINGS = YES|' ${DOXYGEN_CFG}
                    sed -i 's|^WARN_IF_UNDOCUMENTED *=.*|WARN_IF_UNDOCUMENTED = YES|' ${DOXYGEN_CFG}
                    sed -i 's|^WARN_IF_DOC_ERROR *=.*|WARN_IF_DOC_ERROR = YES|' ${DOXYGEN_CFG}
                    sed -i 's|^WARN_LOGFILE *=.*|WARN_LOGFILE = doxygen_warnings.log|' ${DOXYGEN_CFG}

                    echo "===== CONFIG CHECK ====="
                    grep -E "^(INPUT|GENERATE_|WARN)" ${DOXYGEN_CFG}
                '''
            }
        }

        stage('Run Doxygen') {
            steps {
                sh '''
                    doxygen ${DOXYGEN_CFG}
                    echo "--- First 20 warning lines ---"
                    head -20 ${WARNINGS_LOG} || echo "(log empty)"
                '''
            }
        }

        stage('Pack HTML output') {
            steps {
                sh 'tar -czf ${OUTPUT_ARCHIVE} html/'
            }
        }

        stage('Checkout RepoC') {
            steps {
                dir('repoC') {
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: '*/main']],   // ✅ repo คุณใช้ main
                        userRemoteConfigs: [[url: "${REPO_C_URL}"]]
                    ])
                }
            }
        }

        stage('Run Warning Parser') {
            steps {
                sh '''
                    python3 repoC/doxygen_warning_parser.py ${WARNINGS_LOG}
                    cp "${WARNINGS_LOG%.*}_parsed.csv" ${PARSED_CSV}

                    echo "--- CSV preview ---"
                    head -10 ${PARSED_CSV}
                '''
            }
        }

        stage('Archive artifacts') {
            steps {
                archiveArtifacts artifacts: "${OUTPUT_ARCHIVE}, ${PARSED_CSV}",
                                 fingerprint: true
            }
        }
    }

    post {
        success { echo 'PipelineC SUCCESS ✅' }
        failure { echo 'PipelineC FAILED ❌' }
        cleanup { cleanWs() }
    }
}